{
  "name": "zephyr-cloud-docs",
  "version": "0.0.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZephyrCloudIO/zephyr-documentation.git"
  },
  "scripts": {
    "build": "rspress build",
    "dev": "rspress dev --port 3030",
    "lint": "oxlint",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview": "rspress preview",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint --edit",
    "verify:rsbuild-mf-guide": "node scripts/verify-rsbuild-mf-guide.mjs"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "oxlint"
    ]
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "dependencies": {
    "@intercom/messenger-js-sdk": "^0.0.20",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@rspress/core": "^2.0.23",
    "@rspress/plugin-client-redirects": "^2.0.23",
    "@rspress/plugin-sitemap": "2.0.23",
    "@rspress/shared": "^2.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "lucide-react": "^1.55.0",
    "posthog-js": "^1.438.7",
    "rspress-plugin-mermaid": "^1.0.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@rspress/plugin-algolia": "^2.0.23",
    "@rspress/plugin-llms": "2.0.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "lint-staged": "^17.6.0",
    "lucide-static": "^1.55.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "rsbuild-plugin-open-graph": "^1.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "zephyr-rspress-plugin": "^1.6.0"
  },
  "packageManager": "pnpm@10.33.0"
}
